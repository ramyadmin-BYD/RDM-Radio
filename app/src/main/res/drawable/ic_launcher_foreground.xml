<?xml version="1.0" encoding="utf-8"?>
<!--
    RDM Radio launcher icon (foreground layer): a broadcast dot with signal waves,
    centred in the 66dp safe zone of the 108dp adaptive-icon canvas.
    To use your own logo instead: Android Studio → right-click res → New → Image Asset
    → Launcher Icons (Adaptive and Legacy) → Name "ic_launcher" → pick your PNG/SVG.
    It overwrites this file and mipmap-anydpi-v26/ic_launcher.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- centre dot -->
    <path android:fillColor="#FF00C2FF"
        android:pathData="M54,54m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0" />
    <!-- inner waves -->
    <path android:strokeColor="#FF00C2FF" android:strokeWidth="5" android:strokeLineCap="round"
        android:pathData="M63.9,44.1A14,14 0,0 1,63.9 63.9" />
    <path android:strokeColor="#FF00C2FF" android:strokeWidth="5" android:strokeLineCap="round"
        android:pathData="M44.1,44.1A14,14 0,0 0,44.1 63.9" />
    <!-- outer waves -->
    <path android:strokeColor="#FF3DDC97" android:strokeWidth="5" android:strokeLineCap="round"
        android:pathData="M71,37A24,24 0,0 1,71 71" />
    <path android:strokeColor="#FF3DDC97" android:strokeWidth="5" android:strokeLineCap="round"
        android:pathData="M37,37A24,24 0,0 0,37 71" />
</vector>
