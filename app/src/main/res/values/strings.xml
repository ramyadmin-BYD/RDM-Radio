    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">Internet radio for the BYD Song L and other DiLink 5.0 head units.</string>
    <string name="about_feature_stations">Egyptian, regional and international stations, with Nogoum FM 100.6 built in</string>
    <string name="about_feature_favorites">Favorites, your own stream links, and station list import/export</string>
    <string name="about_feature_autoplay">Resumes your last station automatically when the car starts</string>
    <string name="about_feature_reliability">Automatic reconnect and backup stream addresses, with stream diagnostics</string>
    <string name="about_feature_eq">10-band equalizer with presets, Loudness and volume compensation</string>
    <string name="about_feature_ui">Dark and light themes, English and Arabic, and automatic updates</string>
    <string name="about_feature_car">Designed for the BYD DiLink 5.0 screen: landscape, portrait and split-screen</string>
    <string name="about_designed_by">Designed by</string>
    <string name="about_designer">Eng. Ramy Abdelaziz</string>
